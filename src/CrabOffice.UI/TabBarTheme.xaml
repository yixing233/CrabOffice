<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <SolidColorBrush x:Key="TabBarBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="TabBarBorder" Color="#D4D4D4" />
    <SolidColorBrush x:Key="TabInactive" Color="Transparent" />
    <SolidColorBrush x:Key="TabHover" Color="#E5E5E5" />
    <SolidColorBrush x:Key="TabActive" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TabForeground" Color="#444444" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C43E1C" />
</ResourceDictionary>
