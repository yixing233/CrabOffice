<UserControl x:Class="CrabOffice.UI.TabBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource TabBarBackground}" BorderBrush="{DynamicResource TabBarBorder}" BorderThickness="0,0,0,1">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="PART_Tabs" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="TabRoot" Background="{DynamicResource TabInactive}" Padding="10,6" Margin="0"
                                MouseLeftButtonDown="OnTabMouseDown" CornerRadius="4,4,0,0" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{DynamicResource AccentBrush}"
                                         Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="180"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TabForeground}" />
                                <TextBlock Text="🔒" Margin="4,0,0,0" FontSize="10"
                                           Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                                <Button x:Name="CloseBtn" Content="✕" Margin="8,0,0,0" Width="18" Height="18"
                                        Click="OnCloseClick" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TabForeground}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" SourceName="TabRoot" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TabHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TabActive}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
